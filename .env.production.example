# Ejemplo local para revisar producción. No contiene credenciales reales.
PORT=8080
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow
LOG_LEVEL=info
LOG_DIR=logs
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
JSON_LIMIT_BYTES=102400
REQUEST_TIMEOUT_MS=30000
ENABLE_INTERNAL_ENDPOINTS=false
ENABLE_SWAGGER=true
API_BASE_URL=http://localhost:8080
